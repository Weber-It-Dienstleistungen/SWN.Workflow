@page "/tasks"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Swn.Workflow.Application

@attribute [Authorize]

@inject IMyTaskService MyTaskService
@inject IWorkflowTaskService WorkflowTaskService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Meine Aufgaben</PageTitle>

<div class="container-fluid px-0">

    <div class="mb-4">
        <div class="text-secondary small mb-1">
            Persönlicher Arbeitsbereich
        </div>

        <h1 class="display-6 fw-semibold mb-2">
            Meine Aufgaben
        </h1>

        <p class="text-secondary mb-0">
            Hier bearbeitest du alle Aufgaben,
            die dir direkt oder über deine Rollen zugewiesen sind.
        </p>
    </div>

    @if (_isLoading)
    {
        <div class="text-secondary">
            Aufgaben werden geladen...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }
    else if (_tasks.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="h5 mb-2">
                    Keine offenen Aufgaben
                </h2>

                <p class="text-secondary mb-0">
                    Für deine aktuellen Rollen liegen
                    momentan keine offenen Aufgaben vor.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3 text-secondary">
            @_tasks.Count offene
            @GetTaskCountText(_tasks.Count)
        </div>

        <div class="d-flex flex-column gap-3">

            @foreach (var task in _tasks)
            {
                <div @key="task.Id"
                     class="card shadow-sm">

                    <div class="card-body p-4">

                        <div class="d-flex
                            flex-column
                            flex-xl-row
                            justify-content-between
                            gap-4">

                            <div class="flex-grow-1">

                                <div class="d-flex
                                    flex-wrap
                                    align-items-center
                                    gap-2
                                    mb-2">

                                    <span class="badge text-bg-light border">
                                        @task.AssignedRoleKey
                                    </span>

                                    <span class="badge
                                        @GetStatusBadgeClass(
                                            task.Status)">
                                        @GetStatusText(
                                            task.Status)
                                    </span>

                                </div>

                                <h2 class="h5 mb-1">
                                    @task.Title
                                </h2>

                                <div class="text-secondary mb-3">
                                    @task.WorkflowName
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    task.Description))
                                {
                                    <p class="mb-4">
                                        @task.Description
                                    </p>
                                }

                                <div class="row g-3 small mb-4">

                                    <div class="col-md-4">
                                        <span class="text-secondary">
                                            Mitarbeiter / Betreff
                                        </span>

                                        <div class="fw-semibold">
                                            @task.Subject
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <span class="text-secondary">
                                            Phase
                                        </span>

                                        <div class="fw-semibold">
                                            @task.Phase
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <span class="text-secondary">
                                            Stichtag
                                        </span>

                                        <div class="fw-semibold">
                                            @task.ReferenceDate
                                            .ToString(
                                            "dd.MM.yyyy")
                                        </div>
                                    </div>

                                </div>

                                @if (task.Fields.Count > 0)
                                {
                                    <div class="border rounded p-3 mb-4">

                                        <div class="fw-semibold mb-3">
                                            Aufgabendaten
                                        </div>

                                        <div class="row g-3">

                                            @foreach (var field in
                                                task.Fields
                                                    .OrderBy(
                                                        field =>
                                                            field.SortOrder))
                                            {
                                                <div class="col-lg-6">

                                                    <label class="form-label"
                                                           for="@GetFieldInputId(
                                                                                                                       task.Id,
                                                                                                                       field.SortOrder)">

                                                        @field.Label

                                                        @if (field.IsRequired)
                                                        {
                                                            <span class="text-danger">
                                                                *
                                                            </span>
                                                        }

                                                    </label>

                                                    <div class="input-group">

                                                        <input id="@GetFieldInputId(
                                                                                                                           task.Id,
                                                                                                                           field.SortOrder)"
                                                               type="@GetFieldInputType(
                                                                                                                           field.FieldType)"
                                                               class="form-control"
                                                               maxlength="2000"
                                                               autocomplete="off"
                                                               placeholder="@GetFieldPlaceholder(
                                                                                                                           field)"
                                                               value="@GetFieldDraft(
                                                                                                                           task.Id,
                                                                                                                           field.Key)"
                                                               disabled="@IsSavingField(
                                                                                                                           task.Id,
                                                                                                                           field.Key)"
                                                               @oninput="args =>
                                                                                                                           SetFieldDraft(
                                                                                                                               task.Id,
                                                                                                                               field.Key,
                                                                                                                               args.Value?
                                                                                                                                   .ToString())" />

                                                        @if (field.FieldType == 1
                                                            &&
                                                            field.HasStoredValue
                                                            &&
                                                            CanRevealSecrets())
                                                        {
                                                            <button type="button"
                                                                    class="btn
                                                                btn-outline-secondary"
                                                                    disabled="@IsRevealingSecret(
                                                                                                                                        task.Id,
                                                                                                                                        field.Key)"
                                                                    @onclick="() =>
                                                                                                                                        ToggleSecretAsync(
                                                                                                                                            task.Id,
                                                                                                                                            field.Key)">

                                                                @if (IsRevealingSecret(
                                                                    task.Id,
                                                                    field.Key))
                                                                {
                                                                    <span>
                                                                        Laden...
                                                                    </span>
                                                                }
                                                                else if (IsSecretRevealed(
                                                                    task.Id,
                                                                    field.Key))
                                                                {
                                                                    <span>
                                                                        Ausblenden
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span>
                                                                        Anzeigen
                                                                    </span>
                                                                }

                                                            </button>
                                                        }

                                                        <button type="button"
                                                                class="btn
                                                            btn-outline-secondary"
                                                                disabled="@(!CanSaveField(
                                                                                                                                task.Id,
                                                                                                                                field))"
                                                                @onclick="() =>
                                                                                                                                SaveFieldAsync(
                                                                                                                                    task.Id,
                                                                                                                                    field.Key)">

                                                            @if (IsSavingField(
                                                                task.Id,
                                                                field.Key))
                                                            {
                                                                <span>
                                                                    Speichern...
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>
                                                                    Speichern
                                                                </span>
                                                            }

                                                        </button>

                                                    </div>

                                                    @if (field.FieldType == 1)
                                                    {
                                                        @if (field.HasStoredValue)
                                                        {
                                                            <div class="form-text">
                                                                Ein geschützter Wert
                                                                ist gespeichert.
                                                                Ein neuer Wert ersetzt
                                                                den vorhandenen Wert.
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="form-text">
                                                                Der Wert wird
                                                                verschlüsselt gespeichert.
                                                            </div>
                                                        }

                                                        @if (IsSecretRevealed(
                                                            task.Id,
                                                            field.Key))
                                                        {
                                                            <div class="alert
                                                                alert-warning
                                                                py-2
                                                                px-3
                                                                mt-2
                                                                mb-0">

                                                                <div class="small
                                                                    text-secondary">
                                                                    Geschützter Wert
                                                                </div>

                                                                <div class="fw-semibold">
                                                                    <code>
                                                                        @GetRevealedSecret(
                                                                            task.Id,
                                                                            field.Key)
                                                                    </code>
                                                                </div>

                                                            </div>
                                                        }
                                                    }
                                                    else if (IsSavedField(
                                                        task.Id,
                                                        field.Key))
                                                    {
                                                        <div class="form-text
                                                            text-success">
                                                            Wert gespeichert.
                                                        </div>
                                                    }

                                                    @if (field.FieldType == 1
                                                        &&
                                                        IsSavedField(
                                                            task.Id,
                                                            field.Key))
                                                    {
                                                        <div class="form-text
                                                            text-success">
                                                            Wert verschlüsselt
                                                            gespeichert.
                                                        </div>
                                                    }

                                                </div>
                                            }

                                        </div>

                                        <div class="form-text mt-3">
                                            * Pflichtfeld
                                        </div>

                                    </div>
                                }

                                <div>
                                    <label class="form-label"
                                           for="@($"comment-{task.Id}")">
                                        Notiz / Kommentar
                                    </label>

                                    <textarea id="@($"comment-{task.Id}")"
                                              class="form-control"
                                              rows="3"
                                              maxlength="2000"
                                              value="@GetCommentDraft(
                                                                                      task.Id)"
                                              disabled="@(
                                              _savingCommentTaskId ==
                                              task.Id)"
                                              @oninput="args =>
                                                                                      SetCommentDraft(
                                                                                          task.Id,
                                                                                          args.Value?
                                                                                              .ToString())">
</textarea>

                                <div class="d-flex
                                    justify-content-between
                                    align-items-center
                                    gap-3
                                    mt-2">

                                    <div class="small text-secondary">

                                        @if (_savedCommentTaskId ==
                                            task.Id)
                                        {
                                            <span>
                                                Notiz gespeichert.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @GetCommentLength(
                                                    task.Id)
                                                / 2000 Zeichen
                                            </span>
                                        }

                                    </div>

                                    <button type="button"
                                            class="btn
                                        btn-sm
                                        btn-outline-secondary"
                                            disabled="@(
                                            _savingCommentTaskId ==
                                            task.Id)"
                                            @onclick="() =>
                                                                                            SaveCommentAsync(
                                                                                                task.Id)">

                                            @if (_savingCommentTaskId ==
                                                task.Id)
                                        {
                                            <span>
                                                Speichern...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Notiz speichern
                                            </span>
                                        }

                                    </button>

                                </div>
                            </div>

                        </div>

                        <div style="min-width: 210px;">

                            <label class="form-label
                                small
                                text-secondary"
                                   for="@($"status-{task.Id}")">
                                Status
                            </label>

                            <select id="@($"status-{task.Id}")"
                                    class="form-select"
                                    value="@task.Status"
                                    disabled="@(
                                    _updatingTaskId ==
                                    task.Id)"
                                    @onchange="args =>
                                                                            UpdateTaskStatusAsync(
                                                                                task.Id,
                                                                                args)">

<option value="0">
                                    Offen
                                </option>

                                <option value="1">
                                    In Bearbeitung
                                </option>

                                <option value="2">
                                    Erledigt
                                </option>

                                <option value="3">
                                    Blockiert
                                </option>

                                <option value="4">
                                    Nicht erforderlich
                                </option>

                            </select>

                            <div class="small text-secondary mt-2">
                                Erledigte oder nicht erforderliche
                                Aufgaben verschwinden aus dieser Liste.
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        }

    </div>
}

</div>

@code {
    private IReadOnlyList<MyTaskItem> _tasks =
        Array.Empty<MyTaskItem>();

    private readonly Dictionary<Guid, string>
        _commentDrafts =
            new();

    private readonly Dictionary<
        (Guid TaskId, string FieldKey),
        string> _fieldDrafts =
            new();

    private readonly Dictionary<
        (Guid TaskId, string FieldKey),
        string> _revealedSecrets =
            new();

    private IReadOnlyCollection<string> _currentRoleKeys =
        Array.Empty<string>();

    private string? _currentUserId;

    private bool _isLoading = true;

    private Guid? _updatingTaskId;

    private Guid? _savingCommentTaskId;

    private Guid? _savedCommentTaskId;

    private (Guid TaskId, string FieldKey)?
        _savingField;

    private (Guid TaskId, string FieldKey)?
        _savedField;

    private (Guid TaskId, string FieldKey)?
        _revealingSecret;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authenticationState.User;

            _currentUserId =
                user.FindFirst(
                    ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(
                _currentUserId))
            {
                throw new InvalidOperationException(
                    "Der angemeldete Benutzer konnte nicht ermittelt werden.");
            }

            _currentRoleKeys =
                user.Claims
                    .Where(claim =>
                        claim.Type ==
                        ClaimTypes.Role)
                    .Select(claim =>
                        claim.Value)
                    .Where(role =>
                        !string.IsNullOrWhiteSpace(
                            role))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToArray();

            await ReloadTasksAsync();

            ResetCommentDrafts();
            ResetFieldDrafts();
        }
        catch
        {
            _errorMessage =
                "Die persönlichen Aufgaben konnten nicht geladen werden.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ReloadTasksAsync()
    {
        if (string.IsNullOrWhiteSpace(
            _currentUserId))
        {
            throw new InvalidOperationException(
                "Der angemeldete Benutzer konnte nicht ermittelt werden.");
        }

        _tasks =
            await MyTaskService
                .GetOpenTasksAsync(
                    _currentUserId,
                    _currentRoleKeys);

        RemoveRevealedSecretsForMissingTasks();
    }

    private async Task UpdateTaskStatusAsync(
        Guid taskInstanceId,
        ChangeEventArgs args)
    {
        if (!int.TryParse(
            args.Value?.ToString(),
            out var status))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(
            _currentUserId))
        {
            _errorMessage =
                "Der angemeldete Benutzer konnte nicht ermittelt werden.";

            return;
        }

        _updatingTaskId =
            taskInstanceId;

        _errorMessage = null;
        _savedCommentTaskId = null;
        _savedField = null;

        try
        {
            await WorkflowTaskService
                .UpdateStatusAsync(
                    taskInstanceId,
                    status,
                    _currentUserId,
                    _currentRoleKeys);

            await ReloadTasksAsync();

            EnsureCommentDrafts();
            EnsureFieldDrafts();
        }
        catch (WorkflowTaskValidationException exception)
        {
            _errorMessage =
                exception.Message;
        }
        catch
        {
            _errorMessage =
                "Der Aufgabenstatus konnte nicht geändert werden.";
        }
        finally
        {
            _updatingTaskId = null;
        }
    }

    private async Task SaveCommentAsync(
        Guid taskInstanceId)
    {
        if (string.IsNullOrWhiteSpace(
            _currentUserId))
        {
            _errorMessage =
                "Der angemeldete Benutzer konnte nicht ermittelt werden.";

            return;
        }

        _savingCommentTaskId =
            taskInstanceId;

        _savedCommentTaskId = null;
        _savedField = null;
        _errorMessage = null;

        try
        {
            _commentDrafts.TryGetValue(
                taskInstanceId,
                out var comment);

            await WorkflowTaskService
                .UpdateCommentAsync(
                    taskInstanceId,
                    comment,
                    _currentUserId,
                    _currentRoleKeys);

            await ReloadTasksAsync();

            var savedTask =
                _tasks.FirstOrDefault(
                    task =>
                        task.Id ==
                        taskInstanceId);

            _commentDrafts[taskInstanceId] =
                savedTask?.Comment ??
                string.Empty;

            EnsureFieldDrafts();

            _savedCommentTaskId =
                taskInstanceId;
        }
        catch
        {
            _errorMessage =
                "Die Notiz konnte nicht gespeichert werden.";
        }
        finally
        {
            _savingCommentTaskId = null;
        }
    }

    private async Task SaveFieldAsync(
        Guid taskInstanceId,
        string fieldKey)
    {
        if (string.IsNullOrWhiteSpace(
            _currentUserId))
        {
            _errorMessage =
                "Der angemeldete Benutzer konnte nicht ermittelt werden.";

            return;
        }

        var fieldIdentity =
            (
                TaskId: taskInstanceId,
                FieldKey: fieldKey
            );

        _savingField =
            fieldIdentity;

        _savedField = null;
        _savedCommentTaskId = null;
        _errorMessage = null;

        try
        {
            _fieldDrafts.TryGetValue(
                fieldIdentity,
                out var value);

            await WorkflowTaskService
                .UpdateFieldValueAsync(
                    taskInstanceId,
                    fieldKey,
                    value,
                    _currentUserId,
                    _currentRoleKeys);

            _revealedSecrets.Remove(
                fieldIdentity);

            await ReloadTasksAsync();

            var savedTask =
                _tasks.FirstOrDefault(
                    task =>
                        task.Id ==
                        taskInstanceId);

            var savedField =
                savedTask?
                    .Fields
                    .FirstOrDefault(
                        field =>
                            string.Equals(
                                field.Key,
                                fieldKey,
                                StringComparison.OrdinalIgnoreCase));

            _fieldDrafts[fieldIdentity] =
                savedField?.Value ??
                string.Empty;

            EnsureCommentDrafts();
            EnsureFieldDrafts();

            _savedField =
                fieldIdentity;
        }
        catch
        {
            _errorMessage =
                "Der Feldwert konnte nicht gespeichert werden.";
        }
        finally
        {
            _savingField = null;
        }
    }

    private async Task ToggleSecretAsync(
        Guid taskInstanceId,
        string fieldKey)
    {
        var fieldIdentity =
            (
                TaskId: taskInstanceId,
                FieldKey: fieldKey
            );

        if (_revealedSecrets.ContainsKey(
            fieldIdentity))
        {
            _revealedSecrets.Remove(
                fieldIdentity);

            return;
        }

        if (string.IsNullOrWhiteSpace(
            _currentUserId))
        {
            _errorMessage =
                "Der angemeldete Benutzer konnte nicht ermittelt werden.";

            return;
        }

        _revealingSecret =
            fieldIdentity;

        _errorMessage = null;

        try
        {
            var value =
                await WorkflowTaskService
                    .GetSecretFieldValueAsync(
                        taskInstanceId,
                        fieldKey,
                        _currentUserId,
                        _currentRoleKeys);

            if (value is null)
            {
                _errorMessage =
                    "Für dieses Feld ist kein geschützter Wert gespeichert.";

                return;
            }

            _revealedSecrets[fieldIdentity] =
                value;
        }
        catch (UnauthorizedAccessException)
        {
            _errorMessage =
                "Du bist nicht berechtigt, diesen geschützten Wert anzuzeigen.";
        }
        catch
        {
            _errorMessage =
                "Der geschützte Wert konnte nicht angezeigt werden.";
        }
        finally
        {
            _revealingSecret = null;
        }
    }

    private void ResetCommentDrafts()
    {
        _commentDrafts.Clear();

        foreach (var task in _tasks)
        {
            _commentDrafts[task.Id] =
                task.Comment ??
                string.Empty;
        }
    }

    private void EnsureCommentDrafts()
    {
        foreach (var task in _tasks)
        {
            if (!_commentDrafts
                .ContainsKey(
                    task.Id))
            {
                _commentDrafts[task.Id] =
                    task.Comment ??
                    string.Empty;
            }
        }
    }

    private void ResetFieldDrafts()
    {
        _fieldDrafts.Clear();

        foreach (var task in _tasks)
        {
            foreach (var field in task.Fields)
            {
                _fieldDrafts[
                    (
                        task.Id,
                        field.Key
                    )] =
                    field.Value ??
                    string.Empty;
            }
        }
    }

    private void EnsureFieldDrafts()
    {
        foreach (var task in _tasks)
        {
            foreach (var field in task.Fields)
            {
                var fieldIdentity =
                    (
                        task.Id,
                        field.Key
                    );

                if (!_fieldDrafts
                    .ContainsKey(
                        fieldIdentity))
                {
                    _fieldDrafts[fieldIdentity] =
                        field.Value ??
                        string.Empty;
                }
            }
        }
    }

    private void RemoveRevealedSecretsForMissingTasks()
    {
        var existingTaskIds =
            _tasks
                .Select(task =>
                    task.Id)
                .ToHashSet();

        var keysToRemove =
            _revealedSecrets.Keys
                .Where(key =>
                    !existingTaskIds.Contains(
                        key.TaskId))
                .ToArray();

        foreach (var key in keysToRemove)
        {
            _revealedSecrets.Remove(
                key);
        }
    }

    private void SetCommentDraft(
        Guid taskInstanceId,
        string? value)
    {
        _commentDrafts[taskInstanceId] =
            value ??
            string.Empty;

        if (_savedCommentTaskId ==
            taskInstanceId)
        {
            _savedCommentTaskId = null;
        }
    }

    private void SetFieldDraft(
        Guid taskInstanceId,
        string fieldKey,
        string? value)
    {
        var fieldIdentity =
            (
                taskInstanceId,
                fieldKey
            );

        _fieldDrafts[fieldIdentity] =
            value ??
            string.Empty;

        if (_savedField ==
            fieldIdentity)
        {
            _savedField = null;
        }
    }

    private string GetCommentDraft(
        Guid taskInstanceId)
    {
        return _commentDrafts
            .TryGetValue(
                taskInstanceId,
                out var value)
            ? value
            : string.Empty;
    }

    private string GetFieldDraft(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _fieldDrafts
            .TryGetValue(
                (
                    taskInstanceId,
                    fieldKey
                ),
                out var value)
            ? value
            : string.Empty;
    }

    private string? GetRevealedSecret(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _revealedSecrets
            .TryGetValue(
                (
                    taskInstanceId,
                    fieldKey
                ),
                out var value)
            ? value
            : null;
    }

    private int GetCommentLength(
        Guid taskInstanceId)
    {
        return GetCommentDraft(
            taskInstanceId)
            .Length;
    }

    private bool CanRevealSecrets()
    {
        return _currentRoleKeys
            .Contains(
                "IT",
                StringComparer.OrdinalIgnoreCase);
    }

    private bool CanSaveField(
        Guid taskInstanceId,
        MyTaskFieldItem field)
    {
        if (IsSavingField(
            taskInstanceId,
            field.Key))
        {
            return false;
        }

        if (field.FieldType != 1)
        {
            return true;
        }

        return !string.IsNullOrEmpty(
            GetFieldDraft(
                taskInstanceId,
                field.Key));
    }

    private bool IsSavingField(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _savingField ==
            (
                taskInstanceId,
                fieldKey
            );
    }

    private bool IsSavedField(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _savedField ==
            (
                taskInstanceId,
                fieldKey
            );
    }

    private bool IsRevealingSecret(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _revealingSecret ==
            (
                taskInstanceId,
                fieldKey
            );
    }

    private bool IsSecretRevealed(
        Guid taskInstanceId,
        string fieldKey)
    {
        return _revealedSecrets
            .ContainsKey(
                (
                    taskInstanceId,
                    fieldKey
                ));
    }

    private static string? GetFieldPlaceholder(
        MyTaskFieldItem field)
    {
        if (field.FieldType != 1)
        {
            return null;
        }

        return field.HasStoredValue
            ? "Neuen Wert eingeben, um den vorhandenen zu ersetzen"
            : "Passwort eingeben";
    }

    private static string GetFieldInputId(
        Guid taskInstanceId,
        int sortOrder)
    {
        return
            $"field-{taskInstanceId}-{sortOrder}";
    }

    private static string GetFieldInputType(
        int fieldType)
    {
        return fieldType == 1
            ? "password"
            : "text";
    }

    private static string GetTaskCountText(
        int count)
    {
        return count == 1
            ? "Aufgabe"
            : "Aufgaben";
    }

    private static string GetStatusText(
        int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Erledigt",
            3 => "Blockiert",
            4 => "Nicht erforderlich",
            _ => "Unbekannt"
        };
    }

    private static string GetStatusBadgeClass(
        int status)
    {
        return status switch
        {
            0 => "text-bg-secondary",
            1 => "text-bg-primary",
            2 => "text-bg-success",
            3 => "text-bg-warning",
            4 => "text-bg-light border",
            _ => "text-bg-dark"
        };
    }
}