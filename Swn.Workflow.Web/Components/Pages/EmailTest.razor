@page "/admin/email-test"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Swn.Workflow.Application

@attribute [Authorize(Roles = "USER_ADMIN")]

@inject IEmailSender EmailSender
@inject IWorkflowNotificationDispatcher WorkflowNotificationDispatcher

<PageTitle>E-Mail-Test</PageTitle>

<div class="container-fluid px-0">

    <div class="mb-4">
        <div class="text-secondary small mb-1">
            Administration
        </div>

        <h1 class="display-6 fw-semibold mb-2">
            E-Mail-Test
        </h1>

        <p class="text-secondary mb-0">
            Kontrollierte Funktionstests des konfigurierten
            SMTP-Versands und der Workflow-Benachrichtigungen.
        </p>
    </div>

    <div class="alert alert-info">
        Die Funktionen auf dieser Seite werden ausschließlich
        manuell ausgelöst. Es erfolgt kein automatischer Versand
        beim Öffnen der Seite.
    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-body fw-semibold">
            Testnachricht senden
        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(
                _successMessage))
            {
                <div class="alert alert-success">
                    @_successMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                _errorMessage))
            {
                <div class="alert alert-danger">
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model"
                      OnValidSubmit="SendTestEmailAsync">

                <DataAnnotationsValidator />

                <ValidationSummary />

                <div class="mb-3">

                    <label class="form-label"
                           for="recipientName">
                        Empfängername
                    </label>

                    <InputText id="recipientName"
                               class="form-control"
                               autocomplete="off"
                               @bind-Value="_model.RecipientName" />

                    <div class="form-text">
                        Optional, beispielsweise „Michael Porzig“.
                    </div>

                </div>

                <div class="mb-4">

                    <label class="form-label"
                           for="recipientAddress">
                        E-Mail-Adresse
                    </label>

                    <InputText id="recipientAddress"
                               class="form-control"
                               type="email"
                               autocomplete="off"
                               @bind-Value="_model.RecipientAddress" />

                    <ValidationMessage
                        For="@(() => _model.RecipientAddress)" />

                </div>

                <div class="card bg-body-tertiary mb-4">

                    <div class="card-body">

                        <div class="small text-secondary mb-1">
                            Betreff
                        </div>

                        <div class="fw-semibold mb-3">
                            SWN Workflow – Testbenachrichtigung
                        </div>

                        <div class="small text-secondary mb-1">
                            Inhalt
                        </div>

                        <div>
                            Diese Nachricht wurde automatisch vom
                            neuen SWN Workflow-System erzeugt.
                            Sie dient ausschließlich als technischer
                            Funktionstest. Es ist keine Aktion erforderlich.
                        </div>

                    </div>

                </div>

                <button class="btn btn-primary"
                        type="submit"
                        disabled="@_isSending">

                    @if (_isSending)
                    {
                        <span>
                            Test-E-Mail wird gesendet...
                        </span>
                    }
                    else
                    {
                        <span>
                            Test-E-Mail senden
                        </span>
                    }

                </button>

            </EditForm>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-body fw-semibold">
            Wartende Workflow-Benachrichtigungen
        </div>

        <div class="card-body">

            <p>
                Wartende Benachrichtigungen vom Typ
                <strong>„Aufgabe verfügbar“</strong>
                können hier kontrolliert versendet werden.
            </p>

            <p class="text-secondary">
                Mehrere wartende Aufgaben desselben Empfängers
                innerhalb desselben Vorgangs werden zu
                <strong>einer E-Mail</strong> zusammengefasst.
                Die einzelnen Benachrichtigungseinträge bleiben
                für Status und Nachvollziehbarkeit erhalten.
            </p>

            <div class="alert alert-warning">
                Der Button verarbeitet alle momentan wartenden
                Aufgabenbenachrichtigungen.
                Für jeden betroffenen Empfänger und Vorgang
                kann dabei eine E-Mail versendet werden.
            </div>

            @if (!string.IsNullOrWhiteSpace(
                _dispatchSuccessMessage))
            {
                <div class="alert alert-success">
                    @_dispatchSuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(
                _dispatchErrorMessage))
            {
                <div class="alert alert-danger">
                    @_dispatchErrorMessage
                </div>
            }

            <button type="button"
                    class="btn btn-outline-primary"
                    disabled="@_isDispatching"
                    @onclick="DispatchPendingNotificationsAsync">

                @if (_isDispatching)
                {
                    <span>
                        Benachrichtigungen werden verarbeitet...
                    </span>
                }
                else
                {
                    <span>
                        Wartende Benachrichtigungen senden
                    </span>
                }

            </button>

        </div>
    </div>

</div>

@code {
    private readonly EmailTestFormModel _model =
        new();

    private bool _isSending;

    private bool _isDispatching;

    private string? _successMessage;

    private string? _errorMessage;

    private string? _dispatchSuccessMessage;

    private string? _dispatchErrorMessage;

    private async Task SendTestEmailAsync()
    {
        _isSending =
            true;

        _successMessage =
            null;

        _errorMessage =
            null;

        try
        {
            var recipientName =
                string.IsNullOrWhiteSpace(
                    _model.RecipientName)
                    ? null
                    : _model.RecipientName.Trim();

            var salutation =
                string.IsNullOrWhiteSpace(
                    recipientName)
                    ? "Guten Tag,"
                    : $"Hallo {recipientName},";

            var sentAt =
                DateTimeOffset.Now;

            var textBody =
                $"""
                {salutation}

                diese Nachricht wurde automatisch vom neuen
                SWN Workflow-System erzeugt.

                Sie dient ausschließlich als technischer Funktionstest.
                Es ist keine Aktion erforderlich.

                Zeitpunkt des Tests:
                {sentAt:dd.MM.yyyy HH:mm:ss zzz}

                Viele Grüße
                SWN Workflow
                """;

            var message =
                new EmailMessage(
                    _model.RecipientAddress.Trim(),
                    recipientName,
                    "SWN Workflow – Testbenachrichtigung",
                    textBody);

            await EmailSender.SendAsync(
                message);

            _successMessage =
                $"Die Test-E-Mail wurde an " +
                $"'{_model.RecipientAddress.Trim()}' gesendet.";
        }
        catch (Exception exception)
        {
            _errorMessage =
                $"Die Test-E-Mail konnte nicht gesendet werden: " +
                exception.Message;
        }
        finally
        {
            _isSending =
                false;
        }
    }

    private async Task DispatchPendingNotificationsAsync()
    {
        _isDispatching =
            true;

        _dispatchSuccessMessage =
            null;

        _dispatchErrorMessage =
            null;

        try
        {
            var result =
                await WorkflowNotificationDispatcher
                    .DispatchPendingTaskAvailableAsync();

            if (result.ProcessedGroupCount == 0 &&
                result.FailedNotificationCount == 0)
            {
                _dispatchSuccessMessage =
                    "Es waren keine wartenden " +
                    "Aufgabenbenachrichtigungen vorhanden.";

                return;
            }

            _dispatchSuccessMessage =
                $"Verarbeitung abgeschlossen. " +
                $"Gruppen verarbeitet: {result.ProcessedGroupCount}, " +
                $"E-Mails erfolgreich: {result.SentGroupCount}, " +
                $"E-Mails fehlgeschlagen: {result.FailedGroupCount}, " +
                $"Benachrichtigungen erfolgreich: " +
                $"{result.SentNotificationCount}, " +
                $"Benachrichtigungen fehlgeschlagen: " +
                $"{result.FailedNotificationCount}.";
        }
        catch (Exception exception)
        {
            _dispatchErrorMessage =
                "Die wartenden Benachrichtigungen konnten " +
                "nicht verarbeitet werden: " +
                exception.Message;
        }
        finally
        {
            _isDispatching =
                false;
        }
    }

    private sealed class EmailTestFormModel
    {
        [StringLength(
            200,
            ErrorMessage =
                "Der Empfängername darf maximal 200 Zeichen lang sein.")]
        public string RecipientName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte eine Empfängeradresse angeben.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte eine gültige E-Mail-Adresse angeben.")]
        [StringLength(
            256,
            ErrorMessage =
                "Die E-Mail-Adresse darf maximal 256 Zeichen lang sein.")]
        public string RecipientAddress { get; set; } =
            string.Empty;
    }
}