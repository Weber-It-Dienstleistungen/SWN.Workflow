@page "/workflow/{WorkflowInstanceId:guid}"

@using Swn.Workflow.Application

@inject IWorkflowDetailService WorkflowDetailService
@inject IWorkflowTaskService WorkflowTaskService

<PageTitle>Vorgang</PageTitle>

@if (_isLoading)
{
    <div class="text-secondary">
        Vorgang wird geladen...
    </div>
}
else if (_workflow is null)
{
    <div class="alert alert-warning">
        Der angeforderte Vorgang wurde nicht gefunden.
    </div>

    <a class="btn btn-outline-secondary"
       href="/">
        Zurück zum Dashboard
    </a>
}
else
{
    var completedTasks = _workflow.Tasks.Count(
        task =>
            task.Status == 2 ||
            task.Status == 4);

    var totalTasks = _workflow.Tasks.Count;

    var progress = totalTasks == 0
        ? 0
        : (int)Math.Round(
            completedTasks * 100.0 / totalTasks);

    <div class="mb-4">
        <a class="text-decoration-none"
           href="/">
            ← Zurück zum Dashboard
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <div class="mb-4">
        <div class="text-secondary small mb-1">
            @_workflow.WorkflowName
        </div>

        <div class="d-flex flex-column flex-md-row
            justify-content-between gap-3">
            <div>
                <h1 class="display-6 fw-semibold mb-2">
                    @_workflow.Subject
                </h1>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-light border">
                        @GetWorkflowStatusText(_workflow.Status)
                    </span>

                    <span class="badge text-bg-light border">
                        Stichtag:
                        @_workflow.ReferenceDate.ToString("dd.MM.yyyy")
                    </span>
                </div>
            </div>

            <div class="text-md-end">
                <div class="text-secondary small">
                    Angelegt am
                </div>

                <div>
                    @_workflow.CreatedAt
                    .ToLocalTime()
                    .ToString("dd.MM.yyyy HH:mm")
                </div>

                <div class="text-secondary small mt-2">
                    Angelegt von
                </div>

                <div>
                    @_workflow.CreatedByUserId
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-2">
                <span class="fw-semibold">
                    Gesamtfortschritt
                </span>

                <span>
                    @completedTasks von @totalTasks Aufgaben
                </span>
            </div>

            <div class="progress"
                 role="progressbar"
                 aria-valuenow="@progress"
                 aria-valuemin="0"
                 aria-valuemax="100">
                <div class="progress-bar"
                     style="width: @progress%">
                </div>
            </div>
        </div>
    </div>

    @if (_workflow.Properties.Count > 0)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body fw-semibold">
                Vorgangsdaten
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    @foreach (var property in _workflow.Properties)
                    {
                        <dt class="col-sm-4">
                            @property.Key
                        </dt>

                        <dd class="col-sm-8">
                            @property.Value
                        </dd>
                    }
                </dl>
            </div>
        </div>
    }

    @foreach (var phase in _workflow.Tasks
        .GroupBy(task => task.Phase)
        .OrderBy(group => group.Min(task => task.SortOrder)))
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body fw-semibold">
                @phase.Key
            </div>

            <div class="list-group list-group-flush">
                @foreach (var task in phase.OrderBy(task => task.SortOrder))
                {
                    <div class="list-group-item p-4">
                        <div class="d-flex flex-column flex-lg-row
                            justify-content-between gap-3">

                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap
                                    align-items-center
                                    gap-2 mb-2">

                                    <h2 class="h5 mb-0">
                                        @task.Title
                                    </h2>

                                    <span class="badge
                                        @GetTaskStatusBadgeClass(task.Status)">
                                        @GetTaskStatusText(task.Status)
                                    </span>

                                    @if (task.IsOptional)
                                    {
                                        <span class="badge text-bg-light border">
                                            Optional
                                        </span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    task.Description))
                                {
                                    <p class="text-secondary mb-3">
                                        @task.Description
                                    </p>
                                }

                                <div class="small">
                                    <span class="text-secondary">
                                        Zuständige Rolle:
                                    </span>

                                    <strong>
                                        @task.AssignedRoleKey
                                    </strong>
                                </div>

                                @if (task.CompletedAt is not null)
                                {
                                    <div class="small mt-2">
                                        <span class="text-secondary">
                                            Erledigt:
                                        </span>

                                        @task.CompletedAt.Value
                                        .ToLocalTime()
                                        .ToString("dd.MM.yyyy HH:mm")

                                        @if (!string.IsNullOrWhiteSpace(
                                            task.CompletedByUserId))
                                        {
                                            <span>
                                                durch @task.CompletedByUserId
                                            </span>
                                        }
                                    </div>
                                }

                                <div class="mt-3">
                                    <label class="form-label small"
                                           for="@($"comment-{task.Id}")">
                                        Notiz / Kommentar
                                    </label>

                                    <textarea id="@($"comment-{task.Id}")"
                                              class="form-control"
                                              rows="2"
                                              maxlength="2000"
                                              value="@GetCommentDraft(task.Id)"
                                              disabled="@(_savingCommentTaskId == task.Id)"
                                              @oninput="args =>
                                                                                      SetCommentDraft(
                                                                                          task.Id,
                                                                                          args.Value?.ToString())">
</textarea>

                                <div class="d-flex
                                    justify-content-between
                                    align-items-center
                                    gap-2 mt-2">

                                    <div class="small text-secondary">
                                        @if (_savedCommentTaskId == task.Id)
                                        {
                                            <span>
                                                Notiz gespeichert.
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @GetCommentLength(task.Id)
                                                / 2000 Zeichen
                                            </span>
                                        }
                                    </div>

                                    <button class="btn
                                        btn-sm
                                        btn-outline-secondary"
                                            type="button"
                                            disabled="@(_savingCommentTaskId == task.Id)"
                                            @onclick="() =>
                                                                                            SaveCommentAsync(task.Id)">
                                            @if (_savingCommentTaskId == task.Id)
                                        {
                                            <span>
                                                Speichern...
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                Notiz speichern
                                            </span>
                                        }
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div style="min-width: 190px;">
                            <label class="form-label
                                small
                                text-secondary"
                                   for="@($"status-{task.Id}")">
                                Status
                            </label>

                            <select id="@($"status-{task.Id}")"
                                    class="form-select
                                form-select-sm"
                                    value="@task.Status"
                                    disabled="@(_updatingTaskId == task.Id)"
                                    @onchange="args =>
                                                                            UpdateTaskStatusAsync(
                                                                                task.Id,
                                                                                args)">

<option value="0">
                                    Offen
                                </option>

                                <option value="1">
                                    In Bearbeitung
                                </option>

                                <option value="2">
                                    Erledigt
                                </option>

                                <option value="3">
                                    Blockiert
                                </option>

                                <option value="4">
                                    Nicht erforderlich
                                </option>
                            </select>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
}

@code {
    [Parameter]
    public Guid WorkflowInstanceId { get; set; }

    private WorkflowDetailItem? _workflow;

    private readonly Dictionary<Guid, string> _commentDrafts =
        new();

    private bool _isLoading = true;

    private Guid? _updatingTaskId;

    private Guid? _savingCommentTaskId;

    private Guid? _savedCommentTaskId;

    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        _workflow =
            await WorkflowDetailService.GetByIdAsync(
                WorkflowInstanceId);

        _commentDrafts.Clear();

        if (_workflow is not null)
        {
            foreach (var task in _workflow.Tasks)
            {
                _commentDrafts[task.Id] =
                    task.Comment ?? string.Empty;
            }
        }

        _isLoading = false;
    }

    private async Task UpdateTaskStatusAsync(
        Guid taskInstanceId,
        ChangeEventArgs args)
    {
        if (!int.TryParse(
            args.Value?.ToString(),
            out var status))
        {
            return;
        }

        _updatingTaskId = taskInstanceId;
        _errorMessage = null;
        _savedCommentTaskId = null;

        try
        {
            await WorkflowTaskService.UpdateStatusAsync(
                taskInstanceId,
                status,
                "demo-user");

            _workflow =
                await WorkflowDetailService.GetByIdAsync(
                    WorkflowInstanceId);

            EnsureCommentDrafts();
        }
        catch
        {
            _errorMessage =
                "Der Aufgabenstatus konnte nicht geändert werden.";
        }
        finally
        {
            _updatingTaskId = null;
        }
    }

    private async Task SaveCommentAsync(
        Guid taskInstanceId)
    {
        _savingCommentTaskId = taskInstanceId;
        _savedCommentTaskId = null;
        _errorMessage = null;

        try
        {
            _commentDrafts.TryGetValue(
                taskInstanceId,
                out var comment);

            await WorkflowTaskService.UpdateCommentAsync(
                taskInstanceId,
                comment);

            _workflow =
                await WorkflowDetailService.GetByIdAsync(
                    WorkflowInstanceId);

            var savedTask =
                _workflow?.Tasks.FirstOrDefault(
                    task => task.Id == taskInstanceId);

            _commentDrafts[taskInstanceId] =
                savedTask?.Comment ?? string.Empty;

            _savedCommentTaskId = taskInstanceId;
        }
        catch
        {
            _errorMessage =
                "Die Notiz konnte nicht gespeichert werden.";
        }
        finally
        {
            _savingCommentTaskId = null;
        }
    }

    private void SetCommentDraft(
        Guid taskInstanceId,
        string? value)
    {
        _commentDrafts[taskInstanceId] =
            value ?? string.Empty;

        if (_savedCommentTaskId == taskInstanceId)
        {
            _savedCommentTaskId = null;
        }
    }

    private string GetCommentDraft(
        Guid taskInstanceId)
    {
        return _commentDrafts.TryGetValue(
            taskInstanceId,
            out var value)
            ? value
            : string.Empty;
    }

    private int GetCommentLength(
        Guid taskInstanceId)
    {
        return GetCommentDraft(taskInstanceId).Length;
    }

    private void EnsureCommentDrafts()
    {
        if (_workflow is null)
        {
            return;
        }

        foreach (var task in _workflow.Tasks)
        {
            if (!_commentDrafts.ContainsKey(task.Id))
            {
                _commentDrafts[task.Id] =
                    task.Comment ?? string.Empty;
            }
        }
    }

    private static string GetWorkflowStatusText(int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Abgeschlossen",
            3 => "Abgebrochen",
            _ => "Unbekannt"
        };
    }

    private static string GetTaskStatusText(int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Erledigt",
            3 => "Blockiert",
            4 => "Nicht erforderlich",
            _ => "Unbekannt"
        };
    }

    private static string GetTaskStatusBadgeClass(int status)
    {
        return status switch
        {
            0 => "text-bg-secondary",
            1 => "text-bg-primary",
            2 => "text-bg-success",
            3 => "text-bg-warning",
            4 => "text-bg-light border",
            _ => "text-bg-dark"
        };
    }
}