@page "/workflow/{WorkflowInstanceId:guid}"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Swn.Workflow.Application

@attribute [Authorize]

@inject IWorkflowDetailService WorkflowDetailService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Vorgang</PageTitle>

@if (_isLoading)
{
    <div class="text-secondary">
        Vorgang wird geladen...
    </div>
}
else if (_workflow is null)
{
    <div class="alert alert-warning">
        Der angeforderte Vorgang wurde nicht gefunden
        oder du bist nicht berechtigt, ihn zu öffnen.
    </div>

    <a class="btn btn-outline-secondary"
       href="/">
        Zurück zum Dashboard
    </a>
}
else
{
    var progress = _workflow.TotalTasks == 0
        ? 0
        : (int)Math.Round(
            _workflow.CompletedTasks * 100.0 /
            _workflow.TotalTasks);

    <div class="mb-4">
        <a class="text-decoration-none"
           href="/">
            ← Zurück zum Dashboard
        </a>
    </div>

    <div class="mb-4">
        <div class="text-secondary small mb-1">
            @_workflow.WorkflowName
        </div>

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            gap-3">

            <div>
                <h1 class="display-6 fw-semibold mb-2">
                    @_workflow.Subject
                </h1>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge text-bg-light border">
                        @GetWorkflowStatusText(_workflow.Status)
                    </span>

                    <span class="badge text-bg-light border">
                        Stichtag:
                        @(_workflow.ReferenceDate
                            .ToString("dd.MM.yyyy"))
                    </span>
                </div>
            </div>

            <div class="text-md-end">
                <div class="text-secondary small">
                    Angelegt am
                </div>

                <div>
                    @(_workflow.CreatedAt
                        .ToLocalTime()
                        .ToString("dd.MM.yyyy HH:mm"))
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light border mb-4">
        Diese Ansicht dient der Prozessübersicht.
        Die Bearbeitung einzelner Aufgaben erfolgt
        durch die zuständigen Personen in
        <strong>Meine Aufgaben</strong>.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex
                justify-content-between
                mb-2">

                <span class="fw-semibold">
                    Gesamtfortschritt
                </span>

                <span>
                    @_workflow.CompletedTasks
                    von
                    @_workflow.TotalTasks
                    Aufgaben
                </span>
            </div>

            <div class="progress"
                 role="progressbar"
                 aria-valuenow="@progress"
                 aria-valuemin="0"
                 aria-valuemax="100">

                <div class="progress-bar"
                     style="width: @progress%">
                </div>
            </div>
        </div>
    </div>

    @if (_workflow.Properties.Count > 0)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body fw-semibold">
                Vorgangsdaten
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    @foreach (var property in _workflow.Properties)
                    {
                        <dt class="col-sm-4">
                            @property.Key
                        </dt>

                        <dd class="col-sm-8">
                            @property.Value
                        </dd>
                    }
                </dl>
            </div>
        </div>
    }

    @if (_workflow.Tasks.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <h2 class="h5 mb-2">
                    Keine Aufgaben vorhanden
                </h2>

                <p class="text-secondary mb-0">
                    Für diesen Vorgang wurden keine Aufgaben erzeugt.
                </p>
            </div>
        </div>
    }
    else
    {
        @foreach (var phase in _workflow.Tasks
            .GroupBy(task => task.Phase)
            .OrderBy(group =>
                group.Min(task => task.SortOrder)))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-body fw-semibold">
                    @phase.Key
                </div>

                <div class="list-group list-group-flush">

                    @foreach (var task in phase
                        .OrderBy(task => task.SortOrder))
                    {
                        <div @key="task.Id"
                             class="list-group-item p-4">

                            <div class="d-flex
                                flex-column
                                flex-lg-row
                                justify-content-between
                                gap-3">

                                <div class="flex-grow-1">

                                    <div class="d-flex
                                        flex-wrap
                                        align-items-center
                                        gap-2
                                        mb-2">

                                        <h2 class="h5 mb-0">
                                            @task.Title
                                        </h2>

                                        <span class="badge
                                            @GetTaskStatusBadgeClass(
                                                task.Status)">
                                            @GetTaskStatusText(
                                                task.Status)
                                        </span>

                                        @if (task.IsOptional)
                                        {
                                            <span class="badge
                                                text-bg-light
                                                border">
                                                Optional
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        task.Description))
                                    {
                                        <p class="text-secondary mb-3">
                                            @task.Description
                                        </p>
                                    }

                                    <div class="row g-2 small">

                                        <div class="col-md-6">
                                            <span class="text-secondary">
                                                Zuständige Rolle
                                            </span>

                                            <div class="fw-semibold">
                                                @task.AssignedRoleKey
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(
                                            task.AssignedUserId))
                                        {
                                            <div class="col-md-6">
                                                <span class="text-secondary">
                                                    Direkt zugewiesen
                                                </span>

                                                <div class="fw-semibold">
                                                    @task.AssignedUserId
                                                </div>
                                            </div>
                                        }

                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                        task.Comment))
                                    {
                                        <div class="mt-3">
                                            <div class="small
                                                text-secondary
                                                mb-1">
                                                Notiz / Kommentar
                                            </div>

                                            <div class="border rounded
                                                bg-body-tertiary
                                                p-3">
                                                @task.Comment
                                            </div>
                                        </div>
                                    }

                                    @if (task.CompletedAt is not null)
                                    {
                                        <div class="small mt-3">
                                            <span class="text-secondary">
                                                Erledigt:
                                            </span>

                                            @(task.CompletedAt.Value
                                                .ToLocalTime()
                                                .ToString(
                                                    "dd.MM.yyyy HH:mm"))

                                            @if (!string.IsNullOrWhiteSpace(
                                                task.CompletedByUserId))
                                            {
                                                <span>
                                                    durch
                                                    @task.CompletedByUserId
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    [Parameter]
    public Guid WorkflowInstanceId { get; set; }

    private WorkflowDetailItem? _workflow;

    private bool _isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authenticationState.User;

            var userId =
                user.FindFirst(
                    ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                _workflow = null;
                return;
            }

            _workflow =
                await WorkflowDetailService
                    .GetForInitiatorAsync(
                        WorkflowInstanceId,
                        userId);
        }
        catch
        {
            _workflow = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetWorkflowStatusText(
        int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Abgeschlossen",
            3 => "Abgebrochen",
            _ => "Unbekannt"
        };
    }

    private static string GetTaskStatusText(
        int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Erledigt",
            3 => "Blockiert",
            4 => "Nicht erforderlich",
            _ => "Unbekannt"
        };
    }

    private static string GetTaskStatusBadgeClass(
        int status)
    {
        return status switch
        {
            0 => "text-bg-secondary",
            1 => "text-bg-primary",
            2 => "text-bg-success",
            3 => "text-bg-warning",
            4 => "text-bg-light border",
            _ => "text-bg-dark"
        };
    }
}