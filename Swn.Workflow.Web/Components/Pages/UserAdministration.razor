@page "/admin/users"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Swn.Workflow.Application

@attribute [Authorize(Roles = "USER_ADMIN")]

@inject IUserAdministrationService UserAdministrationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Benutzerverwaltung</PageTitle>

<div class="container-fluid px-0">

    <div class="mb-4">
        <div class="text-secondary small mb-1">
            Administration
        </div>

        <h1 class="display-6 fw-semibold mb-2">
            Benutzerverwaltung
        </h1>

        <p class="text-secondary mb-0">
            Benutzerkonten, Rollen und E-Mail-Adressen verwalten.
        </p>
    </div>

    @if (_isLoading)
    {
        <div class="text-secondary">
            Benutzer werden geladen...
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        _loadErrorMessage))
    {
        <div class="alert alert-danger">
            @_loadErrorMessage
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header bg-body fw-semibold">
                Benutzer anlegen
            </div>

            <div class="card-body">

                @if (!string.IsNullOrWhiteSpace(
                    _createSuccessMessage))
                {
                    <div class="alert alert-success">
                        @_createSuccessMessage
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(
                    _createErrorMessage))
                {
                    <div class="alert alert-danger">
                        @_createErrorMessage
                    </div>
                }

                <EditForm Model="_createModel"
                          OnValidSubmit="CreateUserAsync">

                    <DataAnnotationsValidator />

                    <ValidationSummary />

                    <div class="row">

                        <div class="col-lg-6 mb-3">

                            <label class="form-label"
                                   for="displayName">
                                Anzeigename
                            </label>

                            <InputText id="displayName"
                                       class="form-control"
                                       @bind-Value="_createModel.DisplayName" />

                            <ValidationMessage
                                For="@(() => _createModel.DisplayName)" />

                            <div class="form-text">
                                Beispielsweise die Organisationseinheit
                                oder Funktion laut Organigramm.
                            </div>

                        </div>

                        <div class="col-lg-6 mb-3">

                            <label class="form-label"
                                   for="userName">
                                Benutzername
                            </label>

                            <InputText id="userName"
                                       class="form-control"
                                       autocomplete="off"
                                       @bind-Value="_createModel.UserName" />

                            <ValidationMessage
                                For="@(() => _createModel.UserName)" />

                        </div>

                    </div>

                    <div class="mb-3">

                        <label class="form-label"
                               for="email">
                            E-Mail-Adresse
                        </label>

                        <InputText id="email"
                                   class="form-control"
                                   type="email"
                                   autocomplete="off"
                                   @bind-Value="_createModel.Email" />

                        <ValidationMessage
                            For="@(() => _createModel.Email)" />

                        <div class="form-text">
                            Diese Adresse wird später auch für
                            Workflow-Benachrichtigungen verwendet.
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-lg-6 mb-3">

                            <label class="form-label"
                                   for="password">
                                Initialpasswort
                            </label>

                            <InputText id="password"
                                       class="form-control"
                                       type="password"
                                       autocomplete="new-password"
                                       @bind-Value="_createModel.Password" />

                            <ValidationMessage
                                For="@(() => _createModel.Password)" />

                        </div>

                        <div class="col-lg-6 mb-3">

                            <label class="form-label"
                                   for="confirmPassword">
                                Initialpasswort bestätigen
                            </label>

                            <InputText id="confirmPassword"
                                       class="form-control"
                                       type="password"
                                       autocomplete="new-password"
                                       @bind-Value="_createModel.ConfirmPassword" />

                            <ValidationMessage
                                For="@(() => _createModel.ConfirmPassword)" />

                        </div>

                    </div>

                    <div class="form-text mb-4">
                        Mindestens 8 Zeichen sowie mindestens
                        ein Großbuchstabe, ein Kleinbuchstabe
                        und eine Ziffer.
                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Rollen
                        </label>

                        <div class="row row-cols-1 row-cols-md-2 g-2">

                            @foreach (var role in _createModel.Roles)
                            {
                                <div class="col"
                                     @key="role.RoleName">

                                    <div class="form-check border rounded p-3">

                                        <InputCheckbox
                                            id="@GetCreateRoleCheckboxId(role.RoleName)"
                                            class="form-check-input ms-0 me-2"
                                            @bind-Value="role.IsSelected" />

                                        <label class="form-check-label"
                                               for="@GetCreateRoleCheckboxId(role.RoleName)">
                                            @role.RoleName
                                        </label>

                                    </div>

                                </div>
                            }

                        </div>

                    </div>

                    <button class="btn btn-primary"
                            type="submit"
                            disabled="@_isCreating">

                        @if (_isCreating)
                        {
                            <span>
                                Benutzer wird angelegt...
                            </span>
                        }
                        else
                        {
                            <span>
                                Benutzer anlegen
                            </span>
                        }

                    </button>

                </EditForm>

            </div>
        </div>

        @if (_editModel is not null)
        {
            <div class="card shadow-sm mb-4">

                <div class="card-header
                    bg-body
                    fw-semibold
                    d-flex
                    justify-content-between
                    align-items-center">

                    <span>
                        Benutzer bearbeiten
                    </span>

                    <button class="btn btn-sm btn-outline-secondary"
                            type="button"
                            @onclick="CancelEdit">
                        Schließen
                    </button>

                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(
                        _editErrorMessage))
                    {
                        <div class="alert alert-danger">
                            @_editErrorMessage
                        </div>
                    }

                    <EditForm Model="_editModel"
                              OnValidSubmit="UpdateUserAsync">

                        <DataAnnotationsValidator />

                        <ValidationSummary />

                        <div class="row">

                            <div class="col-lg-6 mb-3">

                                <label class="form-label"
                                       for="editDisplayName">
                                    Anzeigename
                                </label>

                                <InputText id="editDisplayName"
                                           class="form-control"
                                           @bind-Value="_editModel.DisplayName" />

                                <ValidationMessage
                                    For="@(() => _editModel.DisplayName)" />

                            </div>

                            <div class="col-lg-6 mb-3">

                                <label class="form-label"
                                       for="editUserName">
                                    Benutzername
                                </label>

                                <InputText id="editUserName"
                                           class="form-control"
                                           autocomplete="off"
                                           @bind-Value="_editModel.UserName" />

                                <ValidationMessage
                                    For="@(() => _editModel.UserName)" />

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label"
                                   for="editEmail">
                                E-Mail-Adresse
                            </label>

                            <InputText id="editEmail"
                                       class="form-control"
                                       type="email"
                                       autocomplete="off"
                                       @bind-Value="_editModel.Email" />

                            <ValidationMessage
                                For="@(() => _editModel.Email)" />

                        </div>

                        <div class="mb-4">

                            <div class="form-check">

                                <InputCheckbox id="editIsActive"
                                               class="form-check-input"
                                               disabled="@IsEditingOwnAccount"
                                               @bind-Value="_editModel.IsActive" />

                                <label class="form-check-label"
                                       for="editIsActive">
                                    Benutzerkonto aktiv
                                </label>

                            </div>

                            @if (IsEditingOwnAccount)
                            {
                                <div class="form-text">
                                    Das aktuell verwendete eigene
                                    Benutzerkonto kann nicht deaktiviert werden.
                                </div>
                            }

                        </div>

                        <div class="mb-4">

                            <label class="form-label">
                                Rollen
                            </label>

                            <div class="row row-cols-1 row-cols-md-2 g-2">

                                @foreach (var role in _editModel.Roles)
                                {
                                    <div class="col"
                                         @key="role.RoleName">

                                        <div class="form-check border rounded p-3">

                                            <InputCheckbox
                                                id="@GetEditRoleCheckboxId(role.RoleName)"
                                                class="form-check-input ms-0 me-2"
                                                @bind-Value="role.IsSelected" />

                                            <label class="form-check-label"
                                                   for="@GetEditRoleCheckboxId(role.RoleName)">
                                                @role.RoleName
                                            </label>

                                        </div>

                                    </div>
                                }

                            </div>

                        </div>

                        <div class="d-flex gap-2">

                            <button class="btn btn-primary"
                                    type="submit"
                                    disabled="@_isUpdating">

                                @if (_isUpdating)
                                {
                                    <span>
                                        Änderungen werden gespeichert...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Änderungen speichern
                                    </span>
                                }

                            </button>

                            <button class="btn btn-outline-secondary"
                                    type="button"
                                    disabled="@_isUpdating"
                                    @onclick="CancelEdit">
                                Abbrechen
                            </button>

                        </div>

                    </EditForm>

                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(
            _updateSuccessMessage))
        {
            <div class="alert alert-success">
                @_updateSuccessMessage
            </div>
        }

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-2
            mb-3">

            <div class="text-secondary">
                @_users.Count
                @GetUserCountText(
                    _users.Count)
            </div>

            <div class="small text-secondary">
                Benutzer werden deaktiviert statt gelöscht,
                damit historische Zuordnungen erhalten bleiben.
            </div>

        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table
                        table-hover
                        align-middle
                        mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">
                                    Benutzer
                                </th>

                                <th>
                                    Benutzername
                                </th>

                                <th>
                                    E-Mail
                                </th>

                                <th>
                                    Rollen
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="pe-4 text-end">
                                    Aktion
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var user in _users)
                            {
                                <tr @key="user.Id">

                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @user.DisplayName
                                        </div>
                                    </td>

                                    <td>
                                        <code>
                                            @user.UserName
                                        </code>
                                    </td>

                                    <td>
                                        @if (string.IsNullOrWhiteSpace(
                                            user.Email))
                                        {
                                            <span class="text-secondary">
                                                Nicht hinterlegt
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @user.Email
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        <div class="d-flex
                                            flex-wrap
                                            gap-1">

                                            @if (user.Roles.Count == 0)
                                            {
                                                <span class="text-secondary">
                                                    Keine Rolle
                                                </span>
                                            }
                                            else
                                            {
                                                @foreach (var role in
                                                    user.Roles)
                                                {
                                                    <span class="badge
                                                        text-bg-light
                                                        border">
                                                        @role
                                                    </span>
                                                }
                                            }

                                        </div>

                                    </td>

                                    <td>

                                        @if (user.IsActive)
                                        {
                                            <span class="badge
                                                text-bg-success">
                                                Aktiv
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                text-bg-secondary">
                                                Inaktiv
                                            </span>
                                        }

                                    </td>

                                    <td class="pe-4 text-end">

                                        <button class="btn
                                            btn-sm
                                            btn-outline-primary"
                                                type="button"
                                                @onclick="() => BeginEdit(user)">
                                            Bearbeiten
                                        </button>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>
    }

</div>

@code {
    private IReadOnlyList<UserAdministrationItem> _users =
        Array.Empty<UserAdministrationItem>();

    private IReadOnlyList<string> _availableRoles =
        Array.Empty<string>();

    private CreateUserFormModel _createModel =
        new();

    private EditUserFormModel? _editModel;

    private string _currentUserId =
        string.Empty;

    private bool _isLoading =
        true;

    private bool _isCreating;

    private bool _isUpdating;

    private string? _loadErrorMessage;

    private string? _createErrorMessage;

    private string? _createSuccessMessage;

    private string? _editErrorMessage;

    private string? _updateSuccessMessage;

    private bool IsEditingOwnAccount =>
        _editModel is not null &&
        string.Equals(
            _editModel.UserId,
            _currentUserId,
            StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            _currentUserId =
                authenticationState.User
                    .FindFirst(
                        ClaimTypes.NameIdentifier)?
                    .Value ??
                string.Empty;

            if (string.IsNullOrWhiteSpace(
                _currentUserId))
            {
                throw new InvalidOperationException(
                    "Der angemeldete Benutzer konnte nicht ermittelt werden.");
            }

            _availableRoles =
                await UserAdministrationService
                    .GetAvailableRolesAsync();

            ResetCreateModel();

            await LoadUsersAsync();
        }
        catch
        {
            _loadErrorMessage =
                "Die Benutzerverwaltung konnte nicht geladen werden.";
        }
        finally
        {
            _isLoading =
                false;
        }
    }

    private async Task LoadUsersAsync()
    {
        _users =
            await UserAdministrationService
                .GetUsersAsync();
    }

    private async Task CreateUserAsync()
    {
        var selectedRoles =
            _createModel.Roles
                .Where(role =>
                    role.IsSelected)
                .Select(role =>
                    role.RoleName)
                .ToArray();

        if (selectedRoles.Length == 0)
        {
            _createSuccessMessage =
                null;

            _createErrorMessage =
                "Bitte mindestens eine Rolle auswählen.";

            return;
        }

        _isCreating =
            true;

        _createErrorMessage =
            null;

        _createSuccessMessage =
            null;

        try
        {
            var request =
                new CreateUserRequest(
                    _createModel.UserName,
                    _createModel.DisplayName,
                    _createModel.Email,
                    _createModel.Password,
                    selectedRoles);

            var result =
                await UserAdministrationService
                    .CreateUserAsync(
                        request);

            if (!result.Succeeded)
            {
                _createErrorMessage =
                    string.Join(
                        " ",
                        result.Errors);

                return;
            }

            var createdUserName =
                _createModel.UserName.Trim();

            await LoadUsersAsync();

            ResetCreateModel();

            _createSuccessMessage =
                $"Benutzer '{createdUserName}' wurde angelegt.";
        }
        catch
        {
            _createErrorMessage =
                "Der Benutzer konnte nicht angelegt werden.";
        }
        finally
        {
            _isCreating =
                false;
        }
    }

    private void BeginEdit(
        UserAdministrationItem user)
    {
        _editErrorMessage =
            null;

        _updateSuccessMessage =
            null;

        _editModel =
            new EditUserFormModel
            {
                UserId =
                    user.Id,

                UserName =
                    user.UserName,

                DisplayName =
                    user.DisplayName,

                Email =
                    user.Email ??
                    string.Empty,

                IsActive =
                    user.IsActive,

                Roles =
                    _availableRoles
                        .Select(role =>
                            new RoleSelectionModel
                            {
                                RoleName =
                                    role,

                                IsSelected =
                                    user.Roles.Contains(
                                        role,
                                        StringComparer.OrdinalIgnoreCase)
                            })
                        .ToList()
            };
    }

    private void CancelEdit()
    {
        _editModel =
            null;

        _editErrorMessage =
            null;
    }

    private async Task UpdateUserAsync()
    {
        if (_editModel is null)
        {
            return;
        }

        var selectedRoles =
            _editModel.Roles
                .Where(role =>
                    role.IsSelected)
                .Select(role =>
                    role.RoleName)
                .ToArray();

        if (selectedRoles.Length == 0)
        {
            _editErrorMessage =
                "Bitte mindestens eine Rolle auswählen.";

            return;
        }

        _isUpdating =
            true;

        _editErrorMessage =
            null;

        _updateSuccessMessage =
            null;

        try
        {
            var request =
                new UpdateUserRequest(
                    _editModel.UserId,
                    _editModel.UserName,
                    _editModel.DisplayName,
                    _editModel.Email,
                    _editModel.IsActive,
                    selectedRoles);

            var result =
                await UserAdministrationService
                    .UpdateUserAsync(
                        request,
                        _currentUserId);

            if (!result.Succeeded)
            {
                _editErrorMessage =
                    string.Join(
                        " ",
                        result.Errors);

                return;
            }

            var updatedUserName =
                _editModel.UserName.Trim();

            await LoadUsersAsync();

            _editModel =
                null;

            _updateSuccessMessage =
                $"Benutzer '{updatedUserName}' wurde aktualisiert.";
        }
        catch
        {
            _editErrorMessage =
                "Der Benutzer konnte nicht aktualisiert werden.";
        }
        finally
        {
            _isUpdating =
                false;
        }
    }

    private void ResetCreateModel()
    {
        _createModel =
            new CreateUserFormModel
            {
                Roles =
                    _availableRoles
                        .Select(role =>
                            new RoleSelectionModel
                            {
                                RoleName =
                                    role
                            })
                        .ToList()
            };
    }

    private static string GetCreateRoleCheckboxId(
        string roleName)
    {
        return
            $"create-role-{roleName.ToLowerInvariant().Replace('_', '-')}";
    }

    private static string GetEditRoleCheckboxId(
        string roleName)
    {
        return
            $"edit-role-{roleName.ToLowerInvariant().Replace('_', '-')}";
    }

    private static string GetUserCountText(
        int count)
    {
        return count == 1
            ? "Benutzerkonto"
            : "Benutzerkonten";
    }

    private sealed class CreateUserFormModel
    {
        [Required(
            ErrorMessage =
                "Bitte einen Anzeigenamen angeben.")]
        [StringLength(
            200,
            ErrorMessage =
                "Der Anzeigename darf maximal 200 Zeichen lang sein.")]
        public string DisplayName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte einen Benutzernamen angeben.")]
        [StringLength(
            256,
            ErrorMessage =
                "Der Benutzername darf maximal 256 Zeichen lang sein.")]
        public string UserName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte eine gültige E-Mail-Adresse angeben.")]
        [StringLength(
            256,
            ErrorMessage =
                "Die E-Mail-Adresse darf maximal 256 Zeichen lang sein.")]
        public string Email { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte ein Initialpasswort angeben.")]
        [MinLength(
            8,
            ErrorMessage =
                "Das Passwort muss mindestens 8 Zeichen lang sein.")]
        public string Password { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte das Initialpasswort bestätigen.")]
        [Compare(
            nameof(Password),
            ErrorMessage =
                "Die beiden Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } =
            string.Empty;

        public List<RoleSelectionModel> Roles { get; set; } =
            new();
    }

    private sealed class EditUserFormModel
    {
        public string UserId { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte einen Anzeigenamen angeben.")]
        [StringLength(
            200,
            ErrorMessage =
                "Der Anzeigename darf maximal 200 Zeichen lang sein.")]
        public string DisplayName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte einen Benutzernamen angeben.")]
        [StringLength(
            256,
            ErrorMessage =
                "Der Benutzername darf maximal 256 Zeichen lang sein.")]
        public string UserName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Bitte eine E-Mail-Adresse angeben.")]
        [EmailAddress(
            ErrorMessage =
                "Bitte eine gültige E-Mail-Adresse angeben.")]
        [StringLength(
            256,
            ErrorMessage =
                "Die E-Mail-Adresse darf maximal 256 Zeichen lang sein.")]
        public string Email { get; set; } =
            string.Empty;

        public bool IsActive { get; set; }

        public List<RoleSelectionModel> Roles { get; set; } =
            new();
    }

    private sealed class RoleSelectionModel
    {
        public string RoleName { get; set; } =
            string.Empty;

        public bool IsSelected { get; set; }
    }
}