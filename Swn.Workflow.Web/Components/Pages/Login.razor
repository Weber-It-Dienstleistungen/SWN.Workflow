@page "/login"

@using Microsoft.AspNetCore.Components

@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Anmelden</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">

        <div class="mb-4 text-center">
            <h1 class="display-6 fw-semibold mb-2">
                SWN Workflow
            </h1>

            <p class="text-secondary mb-0">
                Anmeldung am Workflow-System
            </p>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-body fw-semibold">
                Anmelden
            </div>

            <div class="card-body">

                <form method="post"
                      action="/account/login">

                    <AntiforgeryToken />

                    <div class="mb-3">
                        <label class="form-label"
                               for="userName">
                            Benutzername
                        </label>

                        <input id="userName"
                               name="userName"
                               class="form-control"
                               autocomplete="username"
                               required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label"
                               for="password">
                            Passwort
                        </label>

                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               required />
                    </div>

                    <button class="btn btn-primary w-100"
                            type="submit">
                        Anmelden
                    </button>

                </form>

            </div>
        </div>

        <div class="card shadow-sm mt-3">
            <div class="card-header bg-body fw-semibold">
                Demo-Benutzer
            </div>

            <div class="card-body">

                <div class="small text-secondary mb-3">
                    Gemeinsames Demo-Passwort:
                    <strong class="text-body">
                        Demo1234
                    </strong>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">

                        <thead>
                            <tr>
                                <th scope="col">
                                    Bereich
                                </th>

                                <th scope="col">
                                    Benutzer
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>
                                    Personal / HR
                                </td>

                                <td>
                                    <code>hr.demo</code>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    IT
                                </td>

                                <td>
                                    <code>it.demo</code>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Organisation
                                </td>

                                <td>
                                    <code>organisation.demo</code>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Telenec
                                </td>

                                <td>
                                    <code>telenec.demo</code>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Lager
                                </td>

                                <td>
                                    <code>lager.demo</code>
                                </td>
                            </tr>

                            <tr>
                                <td>
                                    Leitung / Sonderrollen
                                </td>

                                <td>
                                    <code>leitung.demo</code>
                                </td>
                            </tr>
                        </tbody>

                    </table>
                </div>

                <div class="form-text mt-3">
                    Diese Konten dienen ausschließlich
                    der Demonstration des Rollen- und
                    Aufgabenmodells.
                </div>

            </div>
        </div>

    </div>
</div>