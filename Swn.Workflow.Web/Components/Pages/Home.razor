@page "/"

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Swn.Workflow.Application

@attribute [Authorize]

@inject IDashboardService DashboardService
@inject IMyTaskService MyTaskService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SWN Workflow</PageTitle>

<div class="container-fluid px-0">
    <div class="mb-4">
        <h1 class="display-6 fw-semibold mb-2">
            SWN Workflow
        </h1>

        <p class="text-secondary mb-0">
            Übersicht über deine Prozesse und Aufgaben.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="alert alert-danger">
            @_errorMessage
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small mb-2">
                        Eigene aktive Vorgänge
                    </div>

                    <div class="fs-2 fw-semibold">
                        @_activeWorkflows.Count
                    </div>

                    <div class="text-secondary small">
                        Von dir gestartete laufende Geschäftsprozesse
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small mb-2">
                        Meine offenen Aufgaben
                    </div>

                    <div class="fs-2 fw-semibold">
                        @_myOpenTaskCount
                    </div>

                    <div class="text-secondary small">
                        Dir direkt oder über deine Rollen zugewiesen
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-secondary small mb-2">
                        Verfügbare Workflows
                    </div>

                    <div class="fs-2 fw-semibold">
                        @_availableWorkflows.Count
                    </div>

                    <div class="text-secondary small">
                        Von dir startbare Workflow-Vorlagen
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-body fw-semibold">
                    Meine Vorgänge
                </div>

                <div class="card-body p-0">
                    @if (_isLoading)
                    {
                        <div class="text-center text-secondary py-5">
                            Vorgänge werden geladen...
                        </div>
                    }
                    else if (_activeWorkflows.Count == 0)
                    {
                        <div class="text-center py-5">
                            <h2 class="h5 mb-2">
                                Keine eigenen aktiven Vorgänge
                            </h2>

                            <p class="text-secondary mb-0">
                                Von dir gestartete laufende Workflows
                                erscheinen hier.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var workflow in _activeWorkflows)
                            {
                                var progress = GetProgress(workflow);

                                <div class="list-group-item p-4">
                                    <div class="d-flex
                                        flex-column
                                        flex-md-row
                                        justify-content-between
                                        gap-3">

                                        <div class="flex-grow-1">
                                            <div class="d-flex
                                                align-items-center
                                                gap-2 mb-1">

                                                <h2 class="h5 mb-0">
                                                    @workflow.Subject
                                                </h2>

                                                <span class="badge
                                                    text-bg-light
                                                    border">
                                                    @GetStatusText(
                                                        workflow.Status)
                                                </span>
                                            </div>

                                            <div class="text-secondary mb-2">
                                                @workflow.WorkflowName
                                            </div>

                                            <div class="small mb-3">
                                                Stichtag:
                                                <strong>
                                                    @(workflow.ReferenceDate
                                                        .ToString("dd.MM.yyyy"))
                                                </strong>
                                            </div>

                                            <div class="d-flex
                                                justify-content-between
                                                small mb-1">

                                                <span>
                                                    Fortschritt
                                                </span>

                                                <span>
                                                    @workflow.CompletedTasks
                                                    von
                                                    @workflow.TotalTasks
                                                    Aufgaben
                                                </span>
                                            </div>

                                            <div class="progress"
                                                 role="progressbar"
                                                 aria-valuenow="@progress"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">

                                                <div class="progress-bar"
                                                     style="width: @progress%">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center">
                                            <a class="btn btn-outline-primary"
                                               href="@GetDetailUrl(
                                                                                                  workflow.Id)">
                                                Vorgang öffnen
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <AuthorizeView Roles="HR">
                <Authorized>
                    <div class="card shadow-sm">
                        <div class="card-header bg-body fw-semibold">
                            Neuen Vorgang starten
                        </div>

                        <div class="card-body">
                            @if (_isLoading)
                            {
                                <div class="text-secondary">
                                    Workflow-Vorlagen werden geladen...
                                </div>
                            }
                            else if (_availableWorkflows.Count == 0)
                            {
                                <div class="text-secondary">
                                    Keine startbaren Workflow-Vorlagen
                                    vorhanden.
                                </div>
                            }
                            else
                            {
                                <div class="d-grid gap-3">
                                    @foreach (var workflow
                                        in _availableWorkflows)
                                    {
                                        <div>
                                            <a class="btn
                                                btn-outline-primary
                                                w-100"
                                               href="@GetStartUrl(
                                                                                                  workflow.Key)">
                                                @workflow.Name
                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(
                                                workflow.Description))
                                            {
                                                <div class="text-secondary
                                                    small mt-1">
                                                    @workflow.Description
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="card shadow-sm">
                        <div class="card-header bg-body fw-semibold">
                            Arbeitsbereich
                        </div>

                        <div class="card-body">
                            <div class="text-secondary mb-3">
                                Deine zugewiesenen Arbeitsschritte
                                findest du in deinem persönlichen
                                Aufgabenbereich.
                            </div>

                            <a class="btn btn-outline-primary w-100"
                               href="/tasks">
                                Meine Aufgaben öffnen
                            </a>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<WorkflowOverviewItem> _activeWorkflows =
        Array.Empty<WorkflowOverviewItem>();

    private IReadOnlyList<AvailableWorkflowItem> _availableWorkflows =
        Array.Empty<AvailableWorkflowItem>();

    private int _myOpenTaskCount;

    private bool _isLoading = true;

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;

        try
        {
            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user =
                authenticationState.User;

            var userId =
                user.FindFirst(
                    ClaimTypes.NameIdentifier)?
                    .Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                throw new InvalidOperationException(
                    "Der angemeldete Benutzer konnte nicht ermittelt werden.");
            }

            var roleKeys =
                user.Claims
                    .Where(claim =>
                        claim.Type ==
                        ClaimTypes.Role)
                    .Select(claim =>
                        claim.Value)
                    .Where(role =>
                        !string.IsNullOrWhiteSpace(role))
                    .Distinct(
                        StringComparer.OrdinalIgnoreCase)
                    .ToArray();

            _activeWorkflows =
                await DashboardService
                    .GetActiveWorkflowsForUserAsync(
                        userId);

            var myTasks =
                await MyTaskService
                    .GetOpenTasksAsync(
                        userId,
                        roleKeys);

            _myOpenTaskCount =
                myTasks.Count;

            if (user.IsInRole("HR"))
            {
                _availableWorkflows =
                    await DashboardService
                        .GetAvailableWorkflowsAsync();
            }
            else
            {
                _availableWorkflows =
                    Array.Empty<AvailableWorkflowItem>();
            }
        }
        catch
        {
            _errorMessage =
                "Das Dashboard konnte nicht geladen werden.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetStartUrl(
        string workflowKey)
    {
        return
            $"/workflow/start/{Uri.EscapeDataString(workflowKey)}";
    }

    private static string GetDetailUrl(
        Guid workflowInstanceId)
    {
        return
            $"/workflow/{workflowInstanceId}";
    }

    private static int GetProgress(
        WorkflowOverviewItem workflow)
    {
        if (workflow.TotalTasks <= 0)
        {
            return 0;
        }

        return (int)Math.Round(
            workflow.CompletedTasks * 100.0 /
            workflow.TotalTasks);
    }

    private static string GetStatusText(
        int status)
    {
        return status switch
        {
            0 => "Offen",
            1 => "In Bearbeitung",
            2 => "Abgeschlossen",
            3 => "Abgebrochen",
            _ => "Unbekannt"
        };
    }
}